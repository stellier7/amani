# Required. 32+ random characters. Used to sign admin session cookies.
AUTH_SECRET=

# Optional Postgres URL (Neon). If unset, local PGlite files are used under ./data/amani
DATABASE_URL=

# First admin accounts, created only when the users table is empty.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Operador
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Dueño

# Optional. If set, product photos go to Vercel Blob instead of /public/uploads
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_SITE_URL=https://amanijoyeria.com
NEXT_PUBLIC_WHATSAPP_NUMBER=
